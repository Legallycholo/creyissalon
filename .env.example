# Set the canonical public origin to enable indexable production metadata.
NEXT_PUBLIC_SITE_URL=
# International digits only, for example 1787 followed by the local number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=
# Optional. Tracking is disabled until the visitor grants consent.
NEXT_PUBLIC_GTM_ID=
# Andrea stays hidden until the future lead-submission adapter is configured.
NEXT_PUBLIC_ANDREA_ENABLED=false
# Use "google" only with the Google Cloud variables below; failures fall back locally.
ANDREA_CHAT_PROVIDER=local
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_AGENT_RESOURCE_ID=
# Server-only JSON; never prefix this value with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_JSON=
